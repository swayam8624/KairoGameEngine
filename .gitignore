# macOS and local IDE state
.DS_Store
**/.DS_Store
/.idea/

# Root superbuild output. Component build directories are ignored by their
# owning repositories and are never stored by this superproject.
/build/
/build-*/
/out/
/cmake-build-*/
/CMakeUserPresets.json
/_CPack_Packages/
/KairoGameEngine-*-Source.tar.*
/KairoGameEngine-*-Source.zip

# Reproducible but intentionally opt-in compatibility assets. Their exact
# source URLs and checksums live in TestContent/Compatibility/ASSET_LICENSES.json.
/TestContent/Compatibility/optional/*
!/TestContent/Compatibility/optional/.gitkeep

# Historical local planning notes are not authoritative workspace status.
/Foundation/ROADMAP.md
