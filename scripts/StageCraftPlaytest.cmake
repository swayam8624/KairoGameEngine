# Stage the two built games, not a redistributable SDK or installer.
cmake_minimum_required(VERSION 3.25)
foreach(required SURFACE CAVES OUTPUT ENGINE_REVISION RENDERER_REVISION)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
foreach(game SURFACE CAVES)
    if(NOT EXISTS "${${game}}" OR IS_DIRECTORY "${${game}}")
        message(FATAL_ERROR "Missing built game: ${${game}}")
    endif()
endforeach()
get_filename_component(surface_name "${SURFACE}" NAME)
get_filename_component(caves_name "${CAVES}" NAME)
if(NOT surface_name MATCHES "^KairoCraftStream(\\.exe)?$" OR NOT caves_name MATCHES "^KairoCraftCaves(\\.exe)?$")
    message(FATAL_ERROR "Unexpected Craft executable names")
endif()
get_filename_component(output_parent "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${output_parent}")
# Keep the reservation file: deleting a held lock could split the lock identity.
file(LOCK "${OUTPUT}.lock" GUARD PROCESS TIMEOUT 0 RESULT_VARIABLE reservation)
if(NOT reservation STREQUAL "0")
    message(FATAL_ERROR "Another bundle writer holds the reservation: ${reservation}")
endif()
if(EXISTS "${OUTPUT}" OR IS_SYMLINK "${OUTPUT}")
    message(FATAL_ERROR "Bundle already exists; choose a fresh output path")
endif()
string(RANDOM LENGTH 20 ALPHABET 0123456789abcdef nonce)
set(stage "${OUTPUT}.stage-${nonce}")
file(MAKE_DIRECTORY "${stage}/bin" "${stage}/saves")
file(COPY "${SURFACE}" "${CAVES}" DESTINATION "${stage}/bin")
file(SHA256 "${SURFACE}" surface_hash)
file(SHA256 "${CAVES}" caves_hash)
file(SHA256 "${stage}/bin/${surface_name}" staged_surface_hash)
file(SHA256 "${stage}/bin/${caves_name}" staged_caves_hash)
if(NOT surface_hash STREQUAL staged_surface_hash OR NOT caves_hash STREQUAL staged_caves_hash)
    message(FATAL_ERROR "Bundle binary verification failed; unpublished staging directory: ${stage}")
endif()
file(WRITE "${stage}/manifest.txt" "kairo-craft-playtest 1\nengine ${ENGINE_REVISION}\nrenderer ${RENDERER_REVISION}\n${surface_hash}  bin/${surface_name}\n${caves_hash}  bin/${caves_name}\n")
foreach(mode surface caves)
    if(mode STREQUAL "surface")
        set(game "${surface_name}")
    else()
        set(game "${caves_name}")
    endif()
    if(game MATCHES "\\.exe$")
        file(WRITE "${stage}/run-${mode}.cmd" "@echo off\r\nif \"%~1\"==\"\" (\r\n  \"%~dp0bin\\${game}\" --survival --save \"%~dp0saves\\${mode}.kcraft\"\r\n) else (\r\n  \"%~dp0bin\\${game}\" %*\r\n)\r\nexit /b %errorlevel%\r\n")
    else()
        file(WRITE "${stage}/run-${mode}.sh" "#!/usr/bin/env bash\nset -euo pipefail\nroot=\"$(cd -- \"$(dirname -- \"\${BASH_SOURCE[0]}\")\" && pwd)\"\nif (( $# == 0 )); then\n    set -- --survival --save \"$root/saves/${mode}.kcraft\"\nfi\nexec \"$root/bin/${game}\" \"$@\"\n")
        file(CHMOD "${stage}/run-${mode}.sh" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
    endif()
endforeach()
file(WRITE "${stage}/README.txt" "Kairo Craft developer playtest, not a self-contained installer.\nRun the surface or caves launcher without arguments for survival with its own save file.\nWith arguments, the launcher forwards them unchanged.\nThe host must provide required runtime libraries, graphics drivers and a display.\n")
file(RENAME "${stage}" "${OUTPUT}" RESULT publish)
if(NOT publish STREQUAL "0")
    message(FATAL_ERROR "Bundle publication failed: ${publish}; unpublished staging directory: ${stage}")
endif()
message(STATUS "Craft playtest staged at ${OUTPUT}")
