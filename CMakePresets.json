{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Kairo developer build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "ON",
        "KAIRO_GAME_ENGINE_BUILD_EDITOR": "ON",
        "KAIRO_GAME_ENGINE_BUILD_RAYTRACER": "ON",
        "KAIRO_GAME_ENGINE_BUILD_PHYSICS_SANDBOX": "ON",
        "KAIRO_GAME_ENGINE_BUILD_PHASE1_SAMPLE": "ON"
      }
    },
    {
      "name": "dev-clang",
      "displayName": "Kairo developer build (Clang)",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/dev-clang",
      "toolchainFile": "${sourceDir}/cmake/toolchains/clang.cmake"
    },
    {
      "name": "release",
      "displayName": "Kairo release build",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF",
        "KAIRO_RENDERER_ENABLE_VALIDATION": "OFF"
      }
    },
    {
      "name": "ci-clang",
      "displayName": "Kairo CI build (Clang)",
      "inherits": "dev-clang",
      "binaryDir": "${sourceDir}/build/ci-clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "KAIRO_GAME_ENGINE_BUILD_PHYSICS_SANDBOX": "OFF"
      }
    },
    {
      "name": "ci-sanitized",
      "displayName": "Kairo CI build (ASan + UBSan)",
      "inherits": "dev-clang",
      "binaryDir": "${sourceDir}/build/ci-sanitized",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "KAIRO_GAME_ENGINE_BUILD_EDITOR": "OFF",
        "KAIRO_GAME_ENGINE_BUILD_RAYTRACER": "OFF",
        "KAIRO_GAME_ENGINE_BUILD_PHYSICS_SANDBOX": "OFF",
        "KAIRO_GAME_ENGINE_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "ci-msvc",
      "displayName": "Kairo CI build (MSVC)",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/ci-msvc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "KAIRO_GAME_ENGINE_BUILD_PHYSICS_SANDBOX": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "dev-clang", "configurePreset": "dev-clang" },
    { "name": "release", "configurePreset": "release" },
    { "name": "ci-clang", "configurePreset": "ci-clang" },
    { "name": "ci-sanitized", "configurePreset": "ci-sanitized" },
    { "name": "ci-msvc", "configurePreset": "ci-msvc" }
  ],
  "testPresets": [
    { "name": "dev", "configurePreset": "dev", "output": { "outputOnFailure": true } },
    { "name": "dev-clang", "configurePreset": "dev-clang", "output": { "outputOnFailure": true } },
    { "name": "ci-clang", "configurePreset": "ci-clang", "output": { "outputOnFailure": true } },
    { "name": "ci-sanitized", "configurePreset": "ci-sanitized", "output": { "outputOnFailure": true } },
    { "name": "ci-msvc", "configurePreset": "ci-msvc", "output": { "outputOnFailure": true } }
  ]
}
