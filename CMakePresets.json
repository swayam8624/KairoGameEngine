{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Kairo developer build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "ON",
        "KAIRO_GAME_ENGINE_BUILD_EDITOR": "ON",
        "KAIRO_GAME_ENGINE_BUILD_RAYTRACER": "ON",
        "KAIRO_GAME_ENGINE_BUILD_PHYSICS_SANDBOX": "ON",
        "KAIRO_GAME_ENGINE_BUILD_PHASE1_SAMPLE": "ON",
        "KAIRO_GAME_ENGINE_BUILD_RACING_SAMPLE": "ON",
        "KAIRO_GAME_ENGINE_BUILD_BENCHMARKS": "ON"
      }
    },
    {
      "name": "dev-clang",
      "displayName": "Legacy full developer build (Clang)",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/dev-clang",
      "toolchainFile": "${sourceDir}/cmake/toolchains/clang.cmake"
    },
    {
      "name": "game-clang",
      "displayName": "Game-first developer build (Clang)",
      "inherits": "dev-clang",
      "binaryDir": "${sourceDir}/build/game-clang",
      "cacheVariables": {
        "KAIRO_GAME_ENGINE_BUILD_EDITOR": "ON",
        "KAIRO_GAME_ENGINE_BUILD_PLAYER": "ON",
        "KAIRO_GAME_ENGINE_BUILD_PHASE1_SAMPLE": "ON",
        "KAIRO_GAME_ENGINE_BUILD_RACING_SAMPLE": "OFF",
        "KAIRO_GAME_ENGINE_BUILD_RAYTRACER": "OFF",
        "KAIRO_GAME_ENGINE_BUILD_PHYSICS_SANDBOX": "OFF",
        "KAIRO_GAME_ENGINE_BUILD_AI_CLOUD": "OFF",
        "KAIRO_GAME_ENGINE_BUILD_COMPUTE_STACK": "OFF",
        "KAIRO_GAME_ENGINE_BUILD_MIGRATION": "OFF",
        "KAIRO_GAME_ENGINE_ENABLE_PACKAGING": "OFF",
        "KAIRO_GAME_ENGINE_BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "release",
      "displayName": "Kairo release build",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF",
        "KAIRO_RENDERER_ENABLE_VALIDATION": "OFF",
        "KAIRO_GAME_ENGINE_BUILD_RAYTRACER": "OFF",
        "KAIRO_GAME_ENGINE_BUILD_PHYSICS_SANDBOX": "OFF",
        "KAIRO_GAME_ENGINE_BUILD_RACING_SAMPLE": "OFF",
        "KAIRO_GAME_ENGINE_BUILD_COMPUTE_STACK": "OFF",
        "KAIRO_GAME_ENGINE_BUILD_MIGRATION": "OFF",
        "KAIRO_GAME_ENGINE_BUILD_AI_CLOUD": "OFF",
        "KAIRO_GAME_ENGINE_BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "ci-clang",
      "displayName": "Kairo CI build (Clang)",
      "inherits": "dev-clang",
      "binaryDir": "${sourceDir}/build/ci-clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "KAIRO_GAME_ENGINE_BUILD_PHYSICS_SANDBOX": "OFF",
        "KAIRO_GAME_ENGINE_BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "ci-sanitized",
      "displayName": "Kairo CI build (ASan + UBSan)",
      "inherits": "dev-clang",
      "binaryDir": "${sourceDir}/build/ci-sanitized",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "KAIRO_GAME_ENGINE_BUILD_EDITOR": "OFF",
        "KAIRO_GAME_ENGINE_BUILD_RAYTRACER": "OFF",
        "KAIRO_GAME_ENGINE_BUILD_PHYSICS_SANDBOX": "OFF",
        "KAIRO_GAME_ENGINE_ENABLE_SANITIZERS": "ON",
        "KAIRO_GAME_ENGINE_BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "ci-msvc",
      "displayName": "Kairo runtime CI build (MSVC)",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/ci-msvc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "KAIRO_GAME_ENGINE_BUILD_EDITOR": "OFF",
        "KAIRO_GAME_ENGINE_BUILD_PHYSICS_SANDBOX": "OFF",
        "KAIRO_GAME_ENGINE_BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "compute-stack-clang",
      "displayName": "Kairo integrated compute stack (Clang)",
      "inherits": "dev-clang",
      "binaryDir": "${sourceDir}/build/compute-stack-clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON",
        "KAIRO_GAME_ENGINE_BUILD_COMPUTE_STACK": "ON",
        "KAIRO_GAME_ENGINE_BUILD_EDITOR": "OFF",
        "KAIRO_GAME_ENGINE_BUILD_RAYTRACER": "OFF",
        "KAIRO_GAME_ENGINE_BUILD_PHYSICS_SANDBOX": "OFF",
        "KAIRO_GAME_ENGINE_BUILD_PHASE1_SAMPLE": "OFF",
        "KAIRO_GAME_ENGINE_BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "game-player-clang",
      "displayName": "Game player only (strict gameplay AI)",
      "inherits": "game-clang",
      "binaryDir": "${sourceDir}/build/game-player-clang",
      "cacheVariables": {
        "KAIRO_GAME_ENGINE_BUILD_EDITOR": "OFF",
        "KAIRO_GAME_ENGINE_REQUIRE_GAMEPLAY_AI_SPLIT": "ON"
      }
    },
    {
      "name": "studio-fast",
      "displayName": "Focused incremental Studio development",
      "inherits": "game-clang",
      "binaryDir": "${sourceDir}/build/studio-fast",
      "cacheVariables": {
        "BUILD_TESTING": "OFF",
        "CMAKE_BUILD_TYPE": "Debug",
        "KAIRO_GAME_ENGINE_BUILD_PHASE1_SAMPLE": "OFF",
        "KAIRO_GAME_ENGINE_BUILD_RACING_SAMPLE": "OFF",
        "KAIRO_GAME_ENGINE_BUILD_RAYTRACER": "OFF",
        "KAIRO_GAME_ENGINE_BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "studio-msvc",
      "displayName": "Focused Windows Studio qualification (MSVC)",
      "inherits": "ci-msvc",
      "binaryDir": "${sourceDir}/build/studio-msvc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "KAIRO_GAME_ENGINE_BUILD_EDITOR": "ON",
        "KAIRO_GAME_ENGINE_BUILD_PLAYER": "ON",
        "KAIRO_GAME_ENGINE_BUILD_RAYTRACER": "OFF",
        "KAIRO_GAME_ENGINE_BUILD_PHASE1_SAMPLE": "OFF",
        "KAIRO_GAME_ENGINE_BUILD_RACING_SAMPLE": "OFF",
        "KAIRO_GAME_ENGINE_BUILD_AI_CLOUD": "OFF",
        "KAIRO_GAME_ENGINE_BUILD_COMPUTE_STACK": "OFF",
        "KAIRO_GAME_ENGINE_BUILD_MIGRATION": "OFF",
        "KAIRO_GAME_ENGINE_ENABLE_PACKAGING": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "dev-clang",
      "configurePreset": "dev-clang"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "ci-clang",
      "configurePreset": "ci-clang"
    },
    {
      "name": "ci-sanitized",
      "configurePreset": "ci-sanitized"
    },
    {
      "name": "ci-msvc",
      "configurePreset": "ci-msvc"
    },
    {
      "name": "compute-stack-clang",
      "configurePreset": "compute-stack-clang"
    },
    {
      "name": "game-clang",
      "configurePreset": "game-clang"
    },
    {
      "name": "game-player-clang",
      "configurePreset": "game-player-clang"
    },
    {
      "name": "studio-fast",
      "configurePreset": "studio-fast",
      "targets": [
        "KairoEditorApp",
        "KairoProjectCompiler",
        "KairoPlayer"
      ],
      "jobs": 2
    },
    {
      "name": "studio-editor",
      "configurePreset": "studio-fast",
      "targets": [
        "KairoEditorApp"
      ],
      "jobs": 2
    },
    {
      "name": "studio-player",
      "configurePreset": "studio-fast",
      "targets": [
        "KairoPlayer"
      ],
      "jobs": 2
    },
    {
      "name": "studio-msvc",
      "configurePreset": "studio-msvc",
      "targets": [
        "KairoEditorApp",
        "KairoProjectCompiler",
        "KairoPlayer",
        "KairoWorld2DTool",
        "KairoWorld2DInputTool",
        "KairoWorld2DAudioTool",
        "KairoMenuDocumentTool",
        "KairoEditorTests",
        "KairoEditorPhase4Tests",
        "KairoEditorSelectionBoundsTests",
        "KairoEditorViewportClickTests",
        "KairoEditorViewportInteractionTests",
        "KairoEditorSelectionContourTests",
        "KairoEditorAnimationTimelineTests",
        "KairoEditorLogicTraceCaptureTests",
        "KairoEditorAssetPreviewPixelsTests",
        "KairoEditorAssetImportBatchTests",
        "KairoEditorRenderBridgeTests",
        "KairoEditorUITests",
        "KairoEditorPhysicsPreviewTests",
        "KairoEditorWindowsProcessArgumentsTests",
        "KairoEntityModuleBoundaryTests"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "dev-clang",
      "configurePreset": "dev-clang",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ci-clang",
      "configurePreset": "ci-clang",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ci-sanitized",
      "configurePreset": "ci-sanitized",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ci-msvc",
      "configurePreset": "ci-msvc",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "compute-stack-clang",
      "configurePreset": "compute-stack-clang",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "game-clang",
      "configurePreset": "game-clang",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "game-player-clang",
      "configurePreset": "game-player-clang",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "studio-msvc",
      "configurePreset": "studio-msvc",
      "filter": {
        "include": {
          "name": "^KairoEntityModuleBoundaryTests$|^KairoEditor(Tests|Phase4Tests|SelectionBoundsTests|ViewportClickTests|WindowsProcessArgumentsTests|ViewportInteractionTests|SelectionContourTests|AnimationTimelineTests|LogicTraceCaptureTests|AssetPreviewPixelsTests|AssetImportBatchTests|RenderBridgeTests|UITests|PhysicsPreviewTests)$"
        }
      },
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
