kairo-input 1
action "Move" axis2d
action "Jump" button
action "Quit" button
action "Pause" button
action "Restart" button
action "NewGame" button
bind "Move" key A -1 0 0
bind "Move" key D 1 0 0
bind "Move" key W 0 -1 0
bind "Move" key S 0 1 0
bind "Jump" key Space 1 0 0
bind "Quit" key Escape 1 0 0
bind "Pause" key P 1 0 0
bind "Restart" key R 1 0 0
bind "NewGame" key N 1 0 0
bind "Move" key Left -1 0 0
bind "Move" key Right 1 0 0
bind "Move" key Up 0 -1 0
bind "Move" key Down 0 1 0
bind "Move" gamepad-axis LeftX 1 0 0.2
bind "Move" gamepad-axis LeftY 0 1 0.2
bind "Jump" gamepad-button A 1 0 0
bind "Pause" gamepad-button Start 1 0 0
bind "Restart" gamepad-button X 1 0 0
bind "NewGame" gamepad-button Y 1 0 0
bind "Quit" gamepad-button Back 1 0 0
